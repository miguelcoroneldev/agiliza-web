---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import andrettiLogo from "../../assets/andretti-logo.png";

const DEMO_URL = "/landing-generador-comercial-bedon";
// Configurar con el número completo, incluido el código de país y sin el signo +.
const WHATSAPP_NUMBER = "593984897480";
const WHATSAPP_MESSAGE =
  "Hola Miguel, me interesa conversar sobre la definición de la primera etapa";
const whatsappUrl = WHATSAPP_NUMBER
  ? `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`
  : `/contact?mensaje=${encodeURIComponent(WHATSAPP_MESSAGE)}`;

const references = [
  {
    name: "Toyama",
    logo: "/logos/toyama.png",
    logoBg: "#ffffff",
    text: "Demuestra cómo ordenar una oferta especializada para que el cliente encuentre rápido lo que necesita.",
    points: ["Marca clara", "Categorías ordenadas", "Catálogo especializado"],
  },
  {
    name: "Casa del Rulimán",
    logo: "/logos/casa-del-ruliman.png",
    logoBg: "#0b0b0b",
    text: "Demuestra cómo un catálogo puede convertirse en un canal real de atención y pedidos.",
    points: ["Tienda online", "Búsqueda de productos", "Pedidos y atención multicanal"],
  },
];

const blocks = [
  { n: "ETAPA 1", goal: "Comenzar", title: "Una página que presenta y atrae clientes", description: "Creamos una landing page profesional para que las personas conozcan Comercial Bedón, sus productos y sus servicios, y puedan contactarse fácilmente por WhatsApp o solicitar una cotización.", items: ["Presentar la empresa", "Mostrar la oferta", "Facilitar el contacto"] },
  { n: "ETAPA 2", goal: "Atraer", title: "Llevamos clientes interesados a esa página", description: "Una vez que la página esté lista, utilizamos Meta, TikTok y Google para mostrar Comercial Bedón a las personas que buscan productos y soluciones de agricultura, jardinería y construcción.", items: ["Llegar a más personas", "Despertar interés", "Generar consultas"] },
  { n: "ETAPA 3", goal: "Vender", title: "Convertimos la página en un canal de ventas", description: "Después podemos evolucionar hacia un catálogo o tienda online donde los clientes exploren productos, consulten información, soliciten precios y, cuando corresponda, realicen sus pedidos.", items: ["Explorar productos", "Solicitar precios", "Realizar pedidos"] },
  { n: "ETAPA 4", goal: "Conectar", title: "Conectamos las ventas con la operación", description: "Finalmente, podemos conectar la página, las campañas, los pedidos, los clientes, el inventario y la facturación mediante un sistema central de gestión. Así la información deja de estar dispersa y Comercial Bedón puede trabajar con mayor orden y control.", items: ["Unificar información", "Ordenar la operación", "Mejorar el control"] },
];

---

<Layout title="Propuesta para Comercial Bedón" description="Propuesta de transformación digital para Comercial Bedón: presencia, adquisición, comercio electrónico y sistemas conectados." minimalHeader>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main class="proposal overflow-hidden">
    <section class="hero-video">
      <video controls playsinline preload="metadata" poster="/videos/comercial-bedon-poster.jpg">
        <source src="/videos/comercial-bedon-hero.mp4" type="video/mp4" />
      </video>
    </section>

    <style>
      .hero-video { width: 100%; background: #070707; }
      .hero-video video { display: block; width: 100%; max-height: 100vh; aspect-ratio: 16/9; }
    </style>

    <section class="py-24" aria-labelledby="blocks-title"><Container><div class="section-heading max-w-3xl"><div class="section-icon"><Icon name="bx:bxs-layer" /></div><p class="eyebrow mt-4">Un crecimiento progresivo</p><h2 id="blocks-title">Una transformación digital por etapas</h2><p>Comenzamos con una primera herramienta comercial y avanzamos progresivamente hasta conectar toda la operación de Comercial Bedón.</p></div><div class="mt-12 grid gap-6 md:grid-cols-2">{blocks.map((block) => <article class="card relative"><span class="number">{block.n}</span><h3>{block.title}</h3><p class="mt-4 rounded-lg bg-[#f0eadf] px-4 py-3 text-sm font-medium leading-6 text-[#5c3d0e]"><span class="block text-xs font-bold uppercase tracking-[.12em] text-[#8a5c19]">Paso</span>{block.goal}</p><p>{block.description}</p><ul class="tag-list">{block.items.map((item) => <li>{item}</li>)}</ul></article>)}</div><p class="mx-auto mt-10 max-w-3xl text-center text-base leading-7 text-slate-600">Cada etapa puede desarrollarse de manera independiente, pero todas están diseñadas para conectarse entre sí. El objetivo es comenzar con algo útil y avanzar progresivamente hacia un sistema comercial integrado.</p></Container></section>

    <section class="bg-[#102b24] py-16 text-white" aria-labelledby="andretti-title"><Container><div class="grid gap-8 md:grid-cols-[.7fr_1.3fr] md:items-center"><div class="flex justify-center md:justify-start"><Image src={andrettiLogo} alt="Andretti" class="h-auto w-full max-w-[320px]" /></div><div class="section-heading"><p class="eyebrow text-[#efbd63]">Una marca complementaria</p><h2 id="andretti-title">Andretti también tendrá presencia digital</h2><p class="text-white/70">Andretti, una marca nueva que complementa la oferta de Comercial Bedón, contará con una presencia digital propia para presentar sus productos y fortalecer su reconocimiento.</p></div></div></Container></section>

    <section class="border-y border-slate-200 bg-[#f8faf8] py-24" aria-labelledby="channel-title"><Container><div class="grid gap-14 lg:grid-cols-[.75fr_1.25fr] lg:items-center"><div class="section-heading"><div class="section-icon"><Icon name="bx:bxs-bar-chart-alt-2" /></div><p class="eyebrow mt-4">Objetivo comercial</p><h2 id="channel-title">Vender tanto en el local como en digital</h2><p>La meta es pasar progresivamente de una operación cercana al 95% presencial a una distribución 50/50. Es una dirección estratégica, no una promesa automática.</p><p class="metric-note">Se mide con ventas, pedidos, cotizaciones, clientes e ingresos originados en digital.</p></div><div class="space-y-8 rounded-3xl border border-slate-200 bg-white p-7 shadow-sm md:p-10"><div><div class="mb-3 flex justify-between gap-4"><strong>Hoy, aproximadamente</strong><span>95% presencial / 5% digital</span></div><div class="metric"><i style="width:95%">95%</i><b style="width:5%"></b></div></div><div><div class="mb-3 flex justify-between gap-4"><strong>Meta progresiva</strong><span>50% presencial / 50% digital</span></div><div class="metric"><i style="width:50%">50%</i><b style="width:50%">50%</b></div></div><div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-500"><span class="legend physical">Presencial</span><span class="legend digital">Digital</span></div></div></div></Container></section>

    <section class="py-24" aria-labelledby="references-title"><Container><div class="section-heading max-w-3xl"><div class="section-icon"><Icon name="bx:bxs-book-open" /></div><p class="eyebrow mt-4">Referentes</p><h2 id="references-title">Tomar buenas ideas, no copiar modelos</h2><p>Toyama y Casa del Rulimán muestran dos capacidades útiles. Comercial Bedón puede adaptarlas a su portafolio, sus clientes y su territorio.</p></div><div class="mt-10 grid gap-6 lg:grid-cols-2">{references.map((reference) => <article class="card"><div class="logo-box" style={`background:${reference.logoBg}`}><img src={reference.logo} alt={`Logo de ${reference.name}`} loading="lazy" /></div><p class="eyebrow mt-6">Qué podemos aprender</p><h3>{reference.name}</h3><p>{reference.text}</p><ul class="tag-list">{reference.points.map((point) => <li>{point}</li>)}</ul></article>)}</div></Container></section>

    <section id="ejemplo" class="bg-[#102b24] py-24 text-white"><Container><div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end"><div class="section-heading max-w-3xl"><div class="section-icon section-icon-dark"><Icon name="bx:bxs-show" /></div><p class="eyebrow mt-4 text-[#efbd63]">Para muestra, un ejemplo concreto</p><h2>Vea cómo se sentiría para un cliente</h2><p class="text-white/70">Una demostración de cómo presentar una línea de productos y llevar al visitante hacia una consulta o cotización.</p></div><a href={DEMO_URL} class="button button-light">Ver demostración <span aria-hidden="true">→</span></a></div></Container></section>

    <section class="py-20"><Container><div class="rounded-3xl border border-slate-200 bg-[#f8faf8] p-8 md:p-12"><div class="flex flex-col gap-8 md:flex-row md:items-center"><img src="/agilizalogoparaastro.png" alt="Agiliza" class="h-16 w-auto self-start object-contain" loading="lazy" /><div><div class="section-icon"><Icon name="bx:bxs-building" /></div><p class="eyebrow mt-4">Quiénes somos</p><h2 class="mt-3 text-2xl font-semibold text-slate-900">Tecnología que resuelve problemas comerciales</h2><p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">Agiliza ayuda a pequeñas y medianas empresas a vender, atender y operar mejor con tecnología, marketing digital e inteligencia artificial.</p></div></div><div class="mt-10 grid gap-6 md:grid-cols-2"><article class="overflow-hidden rounded-3xl bg-white"><div class="mx-auto mt-6 h-[280px] w-full max-w-[240px] overflow-hidden rounded-2xl bg-slate-100"><img src="/miguel-coronel.jpg" alt="Miguel Coronel" class="h-full w-full object-cover object-top" loading="lazy" /></div><div class="space-y-3 p-6 text-center"><p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Director</p><h3 class="text-2xl font-semibold text-slate-900">Miguel Coronel</h3></div></article><article class="overflow-hidden rounded-3xl bg-white"><div class="mx-auto mt-6 h-[280px] w-full max-w-[240px] overflow-hidden rounded-2xl bg-slate-100"><img src="/Alba_figuero.jpg" alt="Alba Figuero" class="h-full w-full object-cover object-top" loading="lazy" /></div><div class="space-y-3 p-6 text-center"><p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-400">Estrategia de Marketing</p><h3 class="text-2xl font-semibold text-slate-900">Alba Figuero</h3></div></article></div></div></Container></section>

    <section class="pb-24 pt-10 text-center" aria-labelledby="cta-title"><Container><div class="mx-auto max-w-4xl rounded-[2rem] bg-[#f0eadf] px-6 py-16 md:px-14"><div class="section-icon mx-auto"><Icon name="bx:bxs-conversation" /></div><p class="eyebrow mt-4">Siguiente paso</p><h2 id="cta-title" class="mt-4 text-3xl font-semibold tracking-tight text-slate-900 md:text-5xl">Definamos la primera etapa.</h2><p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-600">Una conversación para elegir el bloque que puede generar valor comercial más rápido para Comercial Bedón.</p><a href={whatsappUrl} class="button mt-9" aria-label={WHATSAPP_NUMBER ? "Conversar por WhatsApp" : "Contactar a Agiliza; número de WhatsApp pendiente de configuración"}>Conversar con Agiliza</a>{!WHATSAPP_NUMBER && <p class="mt-4 text-sm text-slate-500">Mientras se configura WhatsApp, este botón dirige al formulario de contacto.</p>}</div></Container></section>
  </main>

  <script>
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduced && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add("is-visible"); observer.unobserve(entry.target); }
      }), { threshold: .18 });
      document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
    } else document.querySelectorAll(".reveal").forEach((element) => element.classList.add("is-visible"));
  </script>
</Layout>

<style>
  .section-icon{display:grid;width:2.75rem;height:2.75rem;place-items:center;border:1px solid #d7e0dc;border-radius:.8rem;background:#edf3f0;color:#173d33;box-shadow:0 8px 22px rgba(15,42,34,.06)}
  .section-icon :global(svg){width:1.35rem;height:1.35rem}
  .section-icon-dark{border-color:rgba(239,189,99,.28);background:rgba(239,189,99,.1);color:#efbd63;box-shadow:none}
  .visual{overflow:hidden;border-radius:1.5rem;border:1px solid rgba(15,42,34,.12);background:#e9ece4;box-shadow:0 20px 50px rgba(15,42,34,.08)}
  .visual :global(img){display:block;width:100%;height:auto}
  .visual figcaption{padding:.8rem 1rem;background:#fff;font-size:.85rem;color:#64748b}
  .metric-note{margin-top:1.25rem;border-left:2px solid #b77a22;padding-left:1rem;font-size:.92rem;line-height:1.6;color:#475569}
  .proposal{color:#334155}.eyebrow{font-size:.75rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#8a5c19}.section-heading h2{margin-top:1rem;font-size:clamp(2rem,4vw,3.5rem);line-height:1.08;letter-spacing:-.035em;font-weight:600;color:#0f172a}.section-heading>p:last-child{margin-top:1.25rem;font-size:1.05rem;line-height:1.8;color:#64748b}.section-heading.text-white h2,.bg-\[\#102b24\] .section-heading h2{color:white}.lead{font-size:clamp(1.5rem,3vw,2.25rem);line-height:1.35;letter-spacing:-.02em;color:#0f172a}.fallback-pattern{background-image:radial-gradient(circle at 80% 20%,rgba(220,166,75,.18),transparent 30%),linear-gradient(120deg,transparent 45%,rgba(255,255,255,.04) 45%,rgba(255,255,255,.04) 46%,transparent 46%);background-size:auto,52px 52px}.flow{display:grid;gap:2.25rem}.flow li{position:relative;display:flex;align-items:center;gap:1rem;border:1px solid #dbe3de;background:white;padding:1.25rem 1.4rem;border-radius:1rem;box-shadow:0 12px 30px rgba(15,42,34,.05);opacity:0;transform:translateY(12px);transition:.55s ease}.flow li.is-visible{opacity:1;transform:none}.flow li span{font-size:.72rem;font-weight:700;color:#a06116}.flow li strong{color:#173d33}.flow li:not(:last-child):after{content:"↓";position:absolute;left:50%;top:calc(100% + .35rem);color:#a06116}@media(min-width:1024px){.flow{grid-template-columns:repeat(6,1fr);gap:1.25rem}.flow li{min-height:8.5rem;align-items:flex-start;flex-direction:column}.flow li:not(:last-child):after{content:"→";left:calc(100% + .35rem);top:43%}}.card{border:1px solid #e2e8f0;border-radius:1.5rem;padding:2rem;background:white;box-shadow:0 16px 40px rgba(15,23,42,.04)}.card h3{margin-top:.8rem;font-size:1.5rem;font-weight:600;color:#0f172a}.card>p:not(.eyebrow){margin-top:.8rem;line-height:1.7;color:#64748b}.tag-list{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.5rem}.tag-list li{border-radius:999px;background:#f1f5f9;padding:.45rem .75rem;font-size:.82rem;color:#475569}.number{position:absolute;right:1.5rem;top:1.4rem;font-size:.8rem;font-weight:700;color:#b77a22}.metric{display:flex;height:2.75rem;overflow:hidden;border-radius:.65rem;background:#e2e8f0;color:white}.metric i,.metric b{display:flex;align-items:center;padding:0 .8rem;font-size:.8rem;font-style:normal}.metric i{background:#315c4f}.metric b{justify-content:flex-end;background:#c28a34}.legend:before{content:"";display:inline-block;width:.65rem;height:.65rem;margin-right:.4rem;border-radius:50%;background:#315c4f}.legend.digital:before{background:#c28a34}table{width:100%;min-width:760px;border-collapse:collapse;text-align:left}th,td{padding:1rem 1.25rem;border-bottom:1px solid #e2e8f0}thead th{background:#f8fafc;font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;color:#475569}tbody th{font-weight:600;color:#0f172a}tbody td{color:#64748b}tbody td:last-child{color:#315c4f}.button{display:inline-flex;align-items:center;justify-content:center;gap:.65rem;border-radius:.6rem;background:#173d33;padding:.85rem 1.25rem;font-weight:600;color:white;transition:.2s}.button:hover{background:#285b4c;transform:translateY(-1px)}.button:focus-visible{outline:3px solid #e0a94f;outline-offset:3px}.button-light{background:#fff;color:#173d33}.button-light:hover{background:#f7f3ea}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}.reveal{opacity:1!important;transform:none!important;transition:none!important}.button:hover{transform:none}}
  .compare{border:1px solid #e2e8f0;border-radius:1.5rem;overflow:hidden;background:white;box-shadow:0 18px 50px rgba(15,42,34,.06)}
  .compare-row{display:grid;grid-template-columns:.8fr 1.1fr 1.3fr;border-bottom:1px solid #e2e8f0}
  .compare-row:last-child{border-bottom:0}
  .compare-row>div{padding:1.15rem 1.4rem;line-height:1.55}
  .compare-head>div{padding-top:1.6rem;padding-bottom:1.6rem}
  .plan-name{display:block;font-size:1.25rem;font-weight:700;color:#0f172a}
  .plan-sub{display:block;font-size:.85rem;color:#64748b;margin-top:.15rem}
  .criterion{font-weight:600;color:#0f172a}
  .other{color:#64748b}
  .is-agiliza{background:#f1f7f3;color:#173d33;border-left:1px solid #cfe0d7;display:flex;flex-direction:column;justify-content:center}
  .is-agiliza.win{flex-direction:row;align-items:flex-start;gap:.7rem;font-weight:500}
  .compare-head .is-agiliza{background:#102b24;color:white;border-left-color:#102b24}
  .compare-head .plan-name{color:inherit}.compare-head .is-agiliza .plan-sub{color:rgba(255,255,255,.7)}
  .badge{align-self:flex-start;margin-bottom:.4rem;border-radius:999px;background:#efbd63;color:#3b2a08;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.2rem .6rem}
  .mark{flex:none;display:grid;place-items:center;width:1.4rem;height:1.4rem;margin-top:.1rem;border-radius:999px;background:#1f6b4f;color:white;font-size:.8rem;font-weight:700}
  @media (max-width:768px){.compare-row{grid-template-columns:1fr}.compare-head>div:first-child{display:none}.compare-row>div{padding:.8rem 1.1rem}.criterion{padding-bottom:0!important;font-size:.8rem;text-transform:uppercase;letter-spacing:.06em;color:#8a5c19}.is-agiliza{border-left:0}.other:before{content:"Johny Huertas: ";font-weight:600;color:#0f172a}}
  .logo-box{display:flex;align-items:center;justify-content:center;height:6.5rem;border-radius:1rem;border:1px solid #e2e8f0;padding:1rem}
  .logo-box img{max-height:100%;max-width:70%;width:auto;object-fit:contain}
</style>
