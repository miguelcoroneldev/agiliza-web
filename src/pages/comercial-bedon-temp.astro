---
import andrettiLogo from '../assets/comercial-bedon-temp-andretti.png';
import comercialBedonLogo from '../assets/comercial-bedon-temp-logo.png';

const title = 'Comercial Bedon – Sitio web en construcción';
const description =
	'Comercial Bedon está renovando su sitio web para brindarle una mejor atención. Encuentre los productos Andretti y contáctenos por WhatsApp, Facebook o Instagram.';
const siteUrl = 'https://comercialbedon.com.ec/';

const contacts = [
	{
		name: 'WhatsApp',
		detail: '099 713 1335',
		href: 'https://wa.me/message/Z4MPXTDM2WLQD1',
		color: '#25d366',
		icon: 'M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm5.8 14.01c-.24.68-1.42 1.3-1.95 1.35-.5.05-.97.23-3.27-.68-2.77-1.09-4.52-3.92-4.66-4.1-.13-.18-1.11-1.48-1.11-2.82 0-1.34.7-2 .95-2.27.25-.27.54-.34.72-.34h.52c.17 0 .39-.06.61.47.24.56.79 1.92.86 2.06.07.14.11.3.02.48-.09.18-.14.3-.27.46-.14.16-.29.36-.41.48-.14.14-.28.29-.12.56.16.27.71 1.17 1.52 1.9 1.05.93 1.93 1.22 2.2 1.36.27.14.43.11.59-.07.16-.18.68-.79.86-1.07.18-.27.36-.23.61-.14.25.09 1.59.75 1.86.89.27.14.45.2.52.32.07.11.07.66-.17 1.35z',
	},
	{
		name: 'Facebook',
		detail: '/comercialbedon',
		href: 'https://www.facebook.com/comercialbedon/',
		color: '#1877f2',
		icon: 'M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.43-4.92 8.43-9.94z',
	},
	{
		name: 'Instagram',
		detail: '@comercialbedon_ec',
		href: 'https://www.instagram.com/comercialbedon_ec/',
		color: '#e4405f',
		icon: 'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 0 1-1.38-.9 3.72 3.72 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.31-1.46.72-2.13 1.38A5.88 5.88 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13a5.88 5.88 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.88 5.88 0 0 0 2.13-1.38 5.88 5.88 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.88 5.88 0 0 0-1.38-2.13A5.88 5.88 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z',
	},
];

const year = new Date().getFullYear();
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href={comercialBedonLogo.src} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#e30613" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={siteUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_EC" />
		<meta property="og:site_name" content="Comercial Bedon" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={new URL(comercialBedonLogo.src, Astro.url.origin).href} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="stripe" aria-hidden="true"></div>

		<main>
			<header class="brand">
				<img
					src={comercialBedonLogo.src}
					alt="Comercial Bedon"
					width="512"
					height="512"
					class="logo"
				/>
			</header>

			<section class="hero">
				<svg class="sign" viewBox="0 0 100 100" width="112" height="112" aria-hidden="true">
					<polygon points="50,3 97,50 50,97 3,50" fill="#ffc400" stroke="#111" stroke-width="4" stroke-linejoin="round" />
					<polygon points="50,11 89,50 50,89 11,50" fill="none" stroke="#111" stroke-width="2" stroke-linejoin="round" />
					<g fill="#111" stroke="#111" stroke-linecap="round" stroke-linejoin="round">
						<g transform="translate(-4 -3)">
							<circle cx="47" cy="30" r="5" stroke="none" />
							<path d="M45 37 L39 52" stroke-width="7" fill="none" />
							<path d="M39 52 L33 67 M39 52 L47 59 L46 67" stroke-width="5" fill="none" />
							<path d="M44 40 L53 46 M42 45 L55 52" stroke-width="4" fill="none" />
							<path d="M50 39 L59 58" stroke-width="3" fill="none" />
							<polygon points="56,59 63,55 67,63 61,67" stroke-width="1" />
						</g>
						<path d="M62 66 Q68 55 73 66 Z" stroke-width="1" />
					</g>
				</svg>
				<span class="tape">
					<span class="badge">Sitio web en construcción</span>
				</span>
				<h1>Estamos renovando nuestro sitio web</h1>
				<p class="lead">
					En <strong>Comercial Bedon</strong> trabajamos para brindarle una mejor atención.
					Muy pronto podrá conocer nuestro catálogo completo aquí. Mientras tanto, seguimos
					atendiéndole por nuestros canales de siempre.
				</p>
			</section>

			<a class="andretti" href="https://andretti.com.ec" target="_blank" rel="noopener">
				<img src={andrettiLogo.src} alt="Andretti" width="262" height="100" class="andretti-logo" />
				<div class="andretti-body">
					<p class="andretti-title">Conozca la línea completa de productos Andretti</p>
					<p class="andretti-text">
						Explore el catálogo en el sitio oficial de la marca y adquiéralos con la atención
						de siempre de <span class="nowrap">Comercial Bedon</span>.
					</p>
					<span class="cta">
						Ver catálogo Andretti
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
					</span>
				</div>
			</a>

			<section class="contact" aria-labelledby="contact-title">
				<h2 id="contact-title">Contáctenos</h2>
				<ul>
					{
						contacts.map((c) => (
							<li>
								<a href={c.href} target="_blank" rel="noopener" style={`--brand: ${c.color}`}>
									<span class="icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
											<path d={c.icon} />
										</svg>
									</span>
									<span class="text">
										<span class="name">{c.name}</span>
										<span class="detail">{c.detail}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<footer>
			<p>© {year} Comercial Bedon · Ecuador</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--red: #e30613;
		--red-dark: #b8040f;
		--ink: #111111;
		--muted: #5b5b5b;
		--bg: #f6f5f3;
		--card: #ffffff;
		--line: #e6e3df;
		color-scheme: light;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
	}

	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		color: var(--ink);
		background:
			radial-gradient(circle at 15% 0%, rgba(227, 6, 19, 0.08), transparent 40%),
			radial-gradient(circle at 100% 100%, rgba(17, 17, 17, 0.06), transparent 45%),
			var(--bg);
		-webkit-font-smoothing: antialiased;
	}

	.stripe {
		height: 10px;
		background: repeating-linear-gradient(
			-45deg,
			var(--ink) 0 14px,
			var(--red) 14px 28px
		);
	}

	main {
		flex: 1;
		width: 100%;
		max-width: 640px;
		margin: 0 auto;
		padding: 40px 16px 24px;
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.brand {
		display: flex;
		justify-content: center;
	}

	/* The source PNG is square with lots of transparent padding; crop to the wordmark. */
	.logo {
		width: min(100%, 380px);
		height: auto;
		aspect-ratio: 512 / 190;
		object-fit: cover;
		object-position: center;
	}

	.hero {
		text-align: center;
	}

	/* "Men at work" road sign with a gentle sway. */
	.sign {
		display: block;
		margin: 0 auto 16px;
		filter: drop-shadow(0 8px 14px rgba(0, 0, 0, 0.18));
		transform-origin: 50% 0%;
		animation: sway 4s ease-in-out infinite;
	}

	@keyframes sway {
		0%,
		100% {
			transform: rotate(-3deg);
		}
		50% {
			transform: rotate(3deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sign {
			animation: none;
		}
	}

	/* Caution-tape frame around the label. */
	.tape {
		display: inline-block;
		padding: 5px;
		border-radius: 8px;
		background: repeating-linear-gradient(-45deg, #111 0 8px, #ffc400 8px 16px);
		box-shadow: 0 6px 16px -8px rgba(0, 0, 0, 0.4);
	}

	.badge {
		display: block;
		padding: 8px 18px;
		border-radius: 4px;
		background: #ffc400;
		color: #111;
		font-size: 0.85rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1 {
		margin: 18px 0 12px;
		font-size: clamp(1.8rem, 6vw, 2.6rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

	.lead {
		margin: 0 auto;
		max-width: 52ch;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.lead strong {
		color: var(--ink);
	}

	/* Andretti brand: black background with a white inset frame, like its logo. */
	.andretti {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
		padding: 28px 24px;
		border-radius: 18px;
		background: #000;
		box-shadow:
			inset 0 0 0 6px #000,
			inset 0 0 0 8px #fff,
			0 14px 32px -14px rgba(0, 0, 0, 0.6);
		color: #fff;
		text-align: center;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.andretti:hover,
	.andretti:focus-visible {
		transform: translateY(-2px);
		box-shadow:
			inset 0 0 0 6px #000,
			inset 0 0 0 8px #fff,
			0 20px 38px -14px rgba(0, 0, 0, 0.7);
	}

	.andretti-logo {
		width: 170px;
		height: auto;
	}

	.andretti-body {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.andretti p {
		margin: 0;
	}

	.andretti-title {
		font-size: 1.25rem;
		font-weight: 800;
		line-height: 1.25;
	}

	.andretti-text {
		margin-top: 8px !important;
		max-width: 44ch;
		font-size: 0.95rem;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.75);
	}

	.nowrap {
		white-space: nowrap;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 18px;
		padding: 11px 20px;
		border-radius: 999px;
		background: #fff;
		color: #000;
		font-weight: 700;
		font-size: 0.95rem;
	}

	.cta svg {
		transition: transform 0.2s ease;
	}

	.andretti:hover .cta svg {
		transform: translateX(3px);
	}

	.contact h2 {
		margin: 0 0 12px;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
		text-align: center;
	}

	.contact ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 10px;
	}

	.contact a {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 14px 16px;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--card);
		color: var(--ink);
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.contact a:hover,
	.contact a:focus-visible {
		border-color: var(--brand);
		transform: translateY(-1px);
	}

	.icon {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		flex-shrink: 0;
		border-radius: 12px;
		background: var(--brand);
		color: #fff;
	}

	.text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.name {
		font-weight: 700;
	}

	.detail {
		color: var(--muted);
		font-size: 0.9rem;
		overflow-wrap: anywhere;
	}

	a:focus-visible {
		outline: 3px solid var(--ink);
		outline-offset: 3px;
	}

	footer {
		padding: 20px 16px 28px;
		text-align: center;
		color: var(--muted);
		font-size: 0.85rem;
	}

	footer p {
		margin: 0;
	}

	@media (min-width: 560px) {
		main {
			padding-top: 64px;
			gap: 36px;
		}

		.contact ul {
			grid-template-columns: repeat(3, 1fr);
		}

		.contact a {
			flex-direction: column;
			text-align: center;
			padding: 20px 12px;
		}

		.text {
			align-items: center;
		}
	}
</style>
