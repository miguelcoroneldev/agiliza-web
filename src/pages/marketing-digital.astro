---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";

// @ts-ignore
import { Icon } from "astro-icon/components";

const services = [
  {
    title: "Redes Sociales Activas",
    description:
      "Publicaciones constantes en Instagram, Facebook y TikTok para que tu negocio se vea activo, profesional y genere confianza con potenciales clientes.",
    icon: "bx:bxl-instagram",
  },
  {
    title: "Publicidad Pagada (Meta Ads)",
    description:
      "Campañas en Facebook e Instagram orientadas a resultados: más mensajes, contactos y clientes potenciales con inversión ajustada a tu presupuesto.",
    icon: "bx:bxs-bar-chart-alt-2",
  },
  {
    title: "Más Contactos y Leads",
    description:
      "Formularios, landing pages y sistemas simples para que los clientes interesados te contacten fácilmente y no pierdas oportunidades.",
    icon: "bx:bxs-user-plus",
  },
  {
    title: "WhatsApp para Negocios",
    description:
      "Integramos WhatsApp Business para que clientes te escriban rápido, recibas consultas organizadas y respondas de forma más eficiente.",
    icon: "bx:bxl-whatsapp",
  },
  {
    title: "Contenido Constante",
    description:
      "Diseños y publicaciones frecuentes para mantener presencia online sin depender de procesos costosos ni agencias tradicionales.",
    icon: "bx:bxs-pencil",
  },
  {
    title: "Google Maps y Reputación",
    description:
      "Optimizamos tu perfil de Google, reseñas, fotos y presencia local para que más personas encuentren tu negocio cuando buscan servicios cerca.",
    icon: "bx:bxs-map",
  },
  {
    title: "Reportes y Resultados",
    description:
      "Reporte mensual con métricas claras: alcance, interacciones, contactos generados y desempeño de campañas para saber qué funciona.",
    icon: "bx:bxs-report",
  },
];
---

<Layout title="Marketing Digital — Agiliza">
  <Container>
    <section class="py-16">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-[#F15D2D]">
          Agiliza Soluciones
        </p>

        <h1 class="text-3xl font-semibold tracking-tight mt-2">
          Marketing Digital
        </h1>

        <p class="mt-4 text-base text-slate-600 max-w-2xl">
          Más clientes, mejor presencia online y seguimiento real de
          resultados. Ayudamos a negocios ecuatorianos a verse profesionales,
          aparecer mejor en Google, recibir más contactos por WhatsApp y hacer
          marketing sin los costos de una agencia tradicional.
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/contact"
            class="inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium bg-[#F15D2D] text-white hover:bg-[#d94f23] transition-colors"
          >
            Solicitar cotización
          </a>

          <a
            href="/pricing"
            class="inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium border border-[#F15D2D] text-[#F15D2D] hover:bg-[#fff2ed] transition-colors"
          >
            Ver precios
          </a>
        </div>
      </div>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <div class="rounded-2xl border border-black/10 p-5 hover:border-[#F15D2D] transition">
            <div class="flex items-start gap-3">
              <div class="rounded-xl border border-black/10 p-2">
                <Icon
                  name={s.icon}
                  class="h-6 w-6 text-[#F15D2D]"
                />
              </div>

              <div>
                <h2 class="text-base font-semibold">{s.title}</h2>

                <p class="mt-2 text-sm text-slate-500">
                  {s.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-14 rounded-2xl border border-black/10 p-6 bg-slate-50">
        <h3 class="text-lg font-semibold">
          ¿Tu negocio necesita más clientes o visibilidad?
        </h3>

        <p class="mt-2 text-sm text-slate-600 max-w-xl">
          Sin contratos largos ni paquetes complicados. Cuéntame dónde está tu
          negocio, qué estás intentando lograr y armamos un plan que tenga
          sentido para tu presupuesto.
        </p>

        <a
          href="/contact"
          class="mt-4 inline-flex items-center rounded-lg px-4 py-2 text-sm font-medium border border-[#F15D2D] text-[#F15D2D] hover:bg-[#fff2ed] transition-colors"
        >
          Hablemos
        </a>
      </div>
    </section>
  </Container>
</Layout>
```
