    <a class="skip" href="#contenido">Saltar al contenido</a>

    <div class="announce" role="note">
      <div class="container">
        <span class="pulse" aria-hidden="true"></span>
        <p><strong>Estiaje 2026:</strong> <span class="hide-sm">el Gobierno ya aplica desconexiones programadas a la industria.</span> <a href="#contexto">Ver el contexto</a></p>
      </div>
    </div>

    <header class="site-header">
      <div class="container">
        <a href="#top" class="brand" aria-label="Comercial Bedón, inicio">
          <img src="/logos/comercial-bedon-dark.png" alt="Comercial Bedón" width="697" height="205" />
        </a>
        <nav class="nav" aria-label="Secciones">
          <a href="#producto">Producto</a>
          <a href="#calculadora">Calculadora</a>
          <a href="#especificaciones">Especificaciones</a>
          <a href="#preguntas">Preguntas</a>
        </nav>
        <a href={wa(MSG.main)} class="btn btn-primary btn-sm" target="_blank" rel="noopener" data-cta="header">
          <svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>
          Cotizar
        </a>
      </div>
    </header>

    <main id="contenido">
      <!-- Hero -->
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <span class="badge"><b>Nuevo</b> Generador a gasolina CB9000</span>
            <h1 id="hero-title"><span class="dim">La luz se va.</span><span class="lit">Usted sigue.</span></h1>
            <p class="lead">
              El CB9000 entrega <strong>7,5 kW</strong> con un motor de <strong>16 HP</strong>, arranque eléctrico y salidas de 110 y 220 V. Respaldo real para su hogar, su negocio o su finca, con la garantía y el servicio técnico de Comercial Bedón.
            </p>
            <div class="cta-row">
              <a href={wa(MSG.main)} class="btn btn-primary btn-lg" target="_blank" rel="noopener" data-cta="hero">
                <svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>
                Cotizar por WhatsApp
              </a>
              <a href="#calculadora" class="btn btn-ghost btn-lg">
                Calcular mi consumo
                <svg class="icon arrow" aria-hidden="true"><use href="#i-arrow"></use></svg>
              </a>
            </div>
            <ul class="proof" aria-label="Respaldo de Comercial Bedón">
              <li><svg class="icon" aria-hidden="true"><use href="#i-check"></use></svg>Garantía Comercial Bedón</li>
              <li><svg class="icon" aria-hidden="true"><use href="#i-check"></use></svg>Servicio técnico autorizado</li>
              <li><svg class="icon" aria-hidden="true"><use href="#i-check"></use></svg>Repuestos originales</li>
            </ul>
          </div>

          <div class="stage">
            <div class="stage-glow" aria-hidden="true"></div>
            <div class="stage-floor" aria-hidden="true"></div>
            <img
              class="stage-img"
              src="/images/cb9000.webp"
              srcset="/images/cb9000-720.webp 720w, /images/cb9000.webp 1191w"
              sizes="(max-width: 900px) 90vw, 620px"
              width="1191"
              height="1138"
              alt="Generador a gasolina CB9000 de Comercial Bedón con chasis tubular, ruedas y panel de control"
              fetchpriority="high"
              decoding="async"
            />
            <div class="chip chip-a" aria-hidden="true">
              <span class="chip-ico"><svg class="icon"><use href="#i-zap"></use></svg></span>
              <div><strong>16 HP</strong><span>Motor a gasolina</span></div>
            </div>
            <div class="chip chip-b" aria-hidden="true">
              <span class="chip-ico"><svg class="icon"><use href="#i-power"></use></svg></span>
              <div><strong>Arranque eléctrico</strong><span>Con llave y batería</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Key specs -->
      <section class="specbar" aria-label="Datos clave del CB9000">
        <div class="container">
          <ul>
            {keySpecs.map((s) => (
              <li>
                <p class="spec-v">{s.value}<small>{s.unit}</small></p>
                <p class="spec-l">{s.label}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Context -->
      <section class="section tone" id="contexto" aria-labelledby="contexto-title">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Contexto · Octubre 2026</span>
            <h2 class="h2" id="contexto-title">El estiaje ya se siente en la red eléctrica.</h2>
            <p class="lead">
              Desde septiembre, la temporada seca reduce el caudal de los ríos que mueven las hidroeléctricas. El Gobierno ya pidió a la industria bajar su consumo y llama a usar la energía de forma inteligente.
            </p>
          </div>

          <div class="stats">
            {stats.map((s, i) => (
              <article class="stat" data-reveal style={`--d:${i}`}>
                <p class="stat-label">{s.label}</p>
                <p class="stat-value">
                  {s.down && <span class="stat-delta" aria-hidden="true"><svg class="icon"><use href="#i-down"></use></svg></span>}
                  <span>{s.value}{s.unit && <small>{s.unit}</small>}</span>
                </p>
                <p class="stat-detail">{s.detail}</p>
              </article>
            ))}
          </div>

          <div class="note" data-reveal>
            <svg class="icon" aria-hidden="true"><use href="#i-info"></use></svg>
            <p>
              <strong>Lo que dice el Gobierno.</strong> Hoy no hay cortes programados para hogares, y el Ministerio asegura que no los habrá bajo el esquema actual. Aun así, el ministro Juan Carlos Blum reconoció que nadie puede garantizar que no haya apagones, porque no se sabe cómo se comportarán el clima ni el fenómeno de El Niño. Un generador es un seguro: prepararse con tiempo cuesta menos que hacerlo en plena emergencia.
            </p>
          </div>

          <p class="sources">
            <span>Fuentes:</span>
            {sources.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
          </p>
        </div>
      </section>

      <!-- Uses -->
      <section class="section" id="usos" aria-labelledby="usos-title">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Para qué sirve</span>
            <h2 class="h2" id="usos-title">Energía propia, donde la necesite.</h2>
            <p class="lead">Un solo equipo para mantener en marcha lo que más importa cuando la red falla.</p>
          </div>
          <div class="uses">
            {uses.map((u, i) => (
              <article class="use" data-reveal style={`--d:${i}`}>
                <span class="use-ico" aria-hidden="true"><svg class="icon"><use href={`#${u.icon}`}></use></svg></span>
                <h3>{u.title}</h3>
                <p>{u.text}</p>
                <ul class="tags" aria-label={`Usos en ${u.title.toLowerCase()}`}>
                  {u.tags.map((t) => <li>{t}</li>)}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- Calculator -->
      <section class="section dark calc-section" id="calculadora" aria-labelledby="calc-title">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Calculadora de consumo</span>
            <h2 class="h2" id="calc-title">¿Le alcanza? Compruébelo en segundos.</h2>
            <p class="lead">Marque lo que quiere mantener encendido. Usamos consumos típicos de referencia; un asesor confirma su caso antes de que compre.</p>
          </div>

          <div class="calc" id="calc" data-capacity="7500" data-peak="8000" data-state="none" data-reveal>
            <div>
              <div class="presets" role="group" aria-label="Escenarios rápidos">
                <span class="presets-label">Probar un escenario</span>
                {presets.map((p) => (
                  <button type="button" class="preset" data-preset={p.ids.join(",")} aria-pressed="false">{p.label}</button>
                ))}
                <button type="button" class="preset preset-clear" data-preset="" aria-pressed="false">Limpiar</button>
              </div>
              <fieldset style="border:0;margin:0;padding:0;min-width:0">
                <legend class="sr-only">Equipos que quiere alimentar</legend>
                <ul class="items">
                  {appliances.map((a) => (
                    <li>
                      <label class="item">
                        <input type="checkbox" value={a.id} data-watts={a.watts} data-surge={a.surge} data-name={a.name} />
                        <span class="box" aria-hidden="true"><svg class="icon"><use href="#i-check"></use></svg></span>
                        <span class="item-name">{a.name}</span>
                        <span class="item-w">{fmt(a.watts)} W</span>
                      </label>
                    </li>
                  ))}
                </ul>
              </fieldset>
            </div>

            <aside class="result" aria-live="polite" aria-label="Resultado del cálculo">
              <p class="result-label">Consumo continuo estimado</p>
              <p class="result-value"><span id="calc-total">0</span><small>W</small></p>
              <p class="result-cap">de 7.500 W de potencia nominal</p>
              <div class="meter" id="calc-meter" role="meter" aria-label="Carga sobre la potencia nominal" aria-valuemin="0" aria-valuemax="7500" aria-valuenow="0">
                <span class="meter-fill" id="calc-fill"></span>
              </div>
              <div class="meter-scale" aria-hidden="true"><span>0 W</span><span>7.500 W</span></div>
              <p class="status">
                <svg class="icon s-none" aria-hidden="true"><use href="#i-info"></use></svg>
                <svg class="icon s-good" aria-hidden="true"><use href="#i-ok"></use></svg>
                <svg class="icon s-warn" aria-hidden="true"><use href="#i-alert"></use></svg>
                <svg class="icon s-over" aria-hidden="true"><use href="#i-x"></use></svg>
                <span id="calc-status">Sin selección</span>
              </p>
              <p class="status-text" id="calc-status-text">Marque los equipos que quiere mantener encendidos.</p>
              <dl class="rows">
                <div><dt>Equipos seleccionados</dt><dd id="calc-count">0</dd></div>
                <div><dt>Pico estimado de arranque</dt><dd><span id="calc-peak">0</span> W de 8.000 W</dd></div>
              </dl>
              <a href={wa(MSG.calc)} class="btn btn-primary btn-block" id="calc-cta" target="_blank" rel="noopener" data-cta="calculadora">
                <svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>
                Enviar mi lista por WhatsApp
              </a>
              <p class="result-note">Los motores de refrigeradoras, bombas y compresores consumen más al arrancar; el pico estimado suma el arranque del equipo más exigente.</p>
            </aside>
          </div>
        </div>
      </section>

      <!-- Features -->
      <section class="section tone" id="producto" aria-labelledby="producto-title">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Diseño y equipamiento</span>
            <h2 class="h2" id="producto-title">Hecho para trabajar duro.</h2>
            <p class="lead">Explore el CB9000: toque los puntos sobre la imagen para conocer cada detalle.</p>
          </div>

          <div class="features" id="features">
            <div class="showcase" data-reveal>
              <div class="showcase-inner">
                <img src="/images/cb9000.webp" srcset="/images/cb9000-720.webp 720w, /images/cb9000.webp 1191w" sizes="(max-width: 900px) 90vw, 640px" width="1191" height="1138" alt="Vista del generador CB9000 con sus componentes principales" loading="lazy" decoding="async" />
                {features.map((f) => (
                  <button type="button" class:list={["spot", { "is-active": f.n === 1 }]} data-spot={f.n} style={`--x:${f.x}%;--y:${f.y}%`} aria-label={f.title} aria-pressed={f.n === 1 ? "true" : "false"}>
                    {f.n}
                  </button>
                ))}
              </div>
            </div>

            <div data-reveal style="--d:1">
              <div class="flist">
                {features.map((f) => (
                  <button type="button" class:list={["feature", { "is-active": f.n === 1 }]} data-feature={f.n}>
                    <span class="feature-n" aria-hidden="true">{f.n}</span>
                    <span class="feature-t">{f.title}</span>
                    <span class="feature-d"><span>{f.text}</span></span>
                  </button>
                ))}
              </div>
              <p class="safety">
                <svg class="icon" aria-hidden="true"><use href="#i-alert"></use></svg>
                <span>Por seguridad, úselo siempre al aire libre y lejos de puertas y ventanas: los generadores a gasolina emiten monóxido de carbono.</span>
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Specs -->
      <section class="section" id="especificaciones" aria-labelledby="specs-title">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Ficha técnica</span>
            <h2 class="h2" id="specs-title">Especificaciones del CB9000.</h2>
          </div>
          <div class="specs-grid">
            {specGroups.map((g, i) => (
              <article class="spec-card" data-reveal style={`--d:${i}`}>
                <header>
                  <span class="spec-ico" aria-hidden="true"><svg class="icon"><use href={`#${g.icon}`}></use></svg></span>
                  <h3>{g.title}</h3>
                </header>
                <dl>
                  {g.rows.map(([k, v]) => (
                    <div><dt>{k}</dt><dd>{v}</dd></div>
                  ))}
                </dl>
              </article>
            ))}
          </div>
          <div class="specs-foot" data-reveal>
            <p>Datos de referencia del fabricante, sujetos a cambio sin previo aviso. Confirme la configuración del equipo con su asesor.</p>
            <a href={wa(MSG.specs)} class="btn btn-outline" target="_blank" rel="noopener" data-cta="especificaciones">
              <svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>
              Pedir ficha y cotización
            </a>
          </div>
        </div>
      </section>

      <!-- Why Bedón -->
      <section class="section dark" id="respaldo" aria-labelledby="respaldo-title">
        <div class="container why">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Comercial Bedón</span>
            <h2 class="h2" id="respaldo-title">Más que un equipo: respaldo real.</h2>
            <p class="lead">Somos distribuidores de maquinaria agrícola, forestal y de construcción en Imbabura, con servicio técnico y repuestos para que su inversión rinda.</p>
          </div>
          <div class="pillars">
            {pillars.map((p, i) => (
              <article class="pillar" data-reveal style={`--d:${i}`}>
                <span class="pillar-ico" aria-hidden="true"><svg class="icon"><use href={`#${p.icon}`}></use></svg></span>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </article>
            ))}
            <article class="place" data-reveal>
              <span class="place-ico" aria-hidden="true"><svg class="icon"><use href="#i-pin"></use></svg></span>
              <div>
                <h3>Matriz en Ibarra</h3>
                <p>Av. Cristóbal de Troya 5-165 y Luis Fernando Villamar · Lun–Vie 8:00–18:00</p>
                <ul class="branches" aria-label="Puntos de atención">
                  {branches.map((b) => <li>{b}</li>)}
                </ul>
              </div>
              <a href={MAPS} class="btn btn-ghost btn-sm" target="_blank" rel="noopener">
                Cómo llegar
                <svg class="icon arrow" aria-hidden="true"><use href="#i-arrow"></use></svg>
              </a>
            </article>
          </div>
        </div>
      </section>

      <!-- Steps -->
      <section class="section" aria-labelledby="pasos-title">
        <div class="container">
          <div class="section-head center" data-reveal>
            <span class="eyebrow">Cómo comprar</span>
            <h2 class="h2" id="pasos-title">De su mensaje a su generador, en tres pasos.</h2>
          </div>
          <ol class="steps">
            {steps.map((s, i) => (
              <li class="step" data-reveal style={`--d:${i}`}>
                <span class="step-n">0{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- FAQ -->
      <section class="section tone" id="preguntas" aria-labelledby="faq-title">
        <div class="container faq">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Preguntas frecuentes</span>
            <h2 class="h2" id="faq-title">Todo lo que necesita saber.</h2>
            <p class="lead">¿No encuentra su respuesta? Un asesor le atiende directamente por WhatsApp.</p>
            <a href={wa(MSG.faq)} class="btn btn-outline" target="_blank" rel="noopener" data-cta="faq">
              <svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>
              Hacer otra pregunta
            </a>
          </div>
          <div class="qa" data-reveal>
            {faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>
                  {f.q}
                  <span class="plus" aria-hidden="true"><svg class="icon"><use href="#i-plus"></use></svg></span>
                </summary>
                <p class="answer">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="section dark final" id="cotizar" aria-labelledby="final-title">
        <div class="container">
          <span class="eyebrow" data-reveal>Hable con un asesor</span>
          <h2 id="final-title" data-reveal>Prepárese hoy, no en el próximo apagón.</h2>
          <p class="lead" data-reveal>Escríbanos, cuéntenos qué quiere mantener encendido y reciba su cotización del CB9000 con asesoría real.</p>
          <div class="cta-row" style="justify-content:center" data-reveal>
            <a href={wa(MSG.main)} class="btn btn-primary btn-lg" target="_blank" rel="noopener" data-cta="final">
              <svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>
              Cotizar por WhatsApp
            </a>
            <a href={MAPS} class="btn btn-ghost btn-lg" target="_blank" rel="noopener">
              <svg class="icon" aria-hidden="true"><use href="#i-pin"></use></svg>
              Cómo llegar
            </a>
          </div>
          <p class="final-meta" data-reveal>
            <span><svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>{PHONE}</span>
            <span><svg class="icon" aria-hidden="true"><use href="#i-pin"></use></svg>Ibarra, Imbabura</span>
            <span><svg class="icon" aria-hidden="true"><use href="#i-clock"></use></svg>Lun–Vie 8:00–18:00</span>
          </p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <img src="/logos/comercial-bedon-dark.png" alt="Comercial Bedón" width="697" height="205" loading="lazy" />
            <p>Maquinaria agrícola, forestal y de construcción, con servicio técnico y repuestos. Ibarra, Ecuador.</p>
          </div>
          <div>
            <p class="footer-h">Contacto</p>
            <ul>
              <li><a href={wa(MSG.main)} target="_blank" rel="noopener" data-cta="footer">WhatsApp {PHONE}</a></li>
              <li><a href={FB} target="_blank" rel="noopener">Facebook</a></li>
            </ul>
          </div>
          <div>
            <p class="footer-h">Matriz</p>
            <ul>
              <li>Av. Cristóbal de Troya 5-165 y Luis Fernando Villamar, Ibarra</li>
              <li>Lunes a viernes, 8:00–18:00</li>
            </ul>
          </div>
          <div>
            <p class="footer-h">Puntos de atención</p>
            <ul>
              {branches.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Comercial Bedón. Todos los derechos reservados.</span>
          <span>Especificaciones de referencia sujetas a cambio. Precio y disponibilidad por consulta.</span>
        </div>
      </div>
    </footer>

    <a href={wa(MSG.main)} class="wa-fab" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp" data-cta="flotante">
      <svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>
      <span class="wa-fab-label" aria-hidden="true">¿Dudas? Escríbanos</span>
    </a>

    <div class="mobile-cta" aria-hidden="true">
      <img src="/images/cb9000-720.webp" alt="" width="720" height="688" loading="lazy" decoding="async" />
      <div>
        <strong>Generador CB9000</strong>
        <span>16 HP · 7,5 kW · 110/220 V</span>
      </div>
      <a href={wa(MSG.main)} class="btn btn-primary btn-sm" target="_blank" rel="noopener" tabindex="-1" data-cta="barra-movil">
        <svg class="icon" aria-hidden="true"><use href="#i-wa"></use></svg>
        Cotizar
      </a>
    </div>

    <script is:inline>
      (function () {
        var WA = document.body.getAttribute("data-wa");
        var waHref = function (msg) { return "https://wa.me/" + WA + "?text=" + encodeURIComponent(msg); };
        var fmt = function (n) { return String(n).replace(/\B(?=(\d{3})+(?!\d))/g, "."); };
        var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Header
        var header = document.querySelector(".site-header");
        var onScroll = function () { header.classList.toggle("is-scrolled", window.scrollY > 8); };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        // Reveal on scroll
        var reveals = document.querySelectorAll("[data-reveal]");
        if ("IntersectionObserver" in window && !reduce) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
            });
          }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
          reveals.forEach(function (el) { io.observe(el); });
        } else {
          reveals.forEach(function (el) { el.classList.add("is-in"); });
        }

        // Calculator
        var calc = document.getElementById("calc");
        if (calc) {
          var CAP = Number(calc.dataset.capacity);
          var PEAK = Number(calc.dataset.peak);
          var boxes = Array.prototype.slice.call(calc.querySelectorAll('input[type="checkbox"]'));
          var presetBtns = calc.querySelectorAll("[data-preset]");
          var $ = function (id) { return document.getElementById(id); };
          var STATES = {
            none: ["Sin selección", "Marque los equipos que quiere mantener encendidos."],
            good: ["Con margen", "El CB9000 cubre esta carga con holgura."],
            tight: ["Al límite", "Le alcanza, pero conviene escalonar el uso de los equipos más grandes."],
            surge: ["Arranque exigente", "En uso continuo le alcanza. Encienda los motores de uno en uno."],
            over: ["Excede la capacidad", "Supera los 7.500 W nominales. Use los equipos por turnos o consulte otra potencia."]
          };
          var update = function () {
            var total = 0, surge = 0, names = [];
            boxes.forEach(function (b) {
              if (!b.checked) return;
              total += Number(b.dataset.watts);
              surge = Math.max(surge, Number(b.dataset.surge));
              names.push(b.dataset.name);
            });
            var peak = total + surge;
            var pct = Math.min(100, (total / CAP) * 100);
            var state = !names.length ? "none" : total > CAP ? "over" : peak > PEAK ? "surge" : pct > 75 ? "tight" : "good";
            $("calc-total").textContent = fmt(total);
            $("calc-peak").textContent = fmt(peak);
            $("calc-count").textContent = String(names.length);
            $("calc-fill").style.width = pct + "%";
            $("calc-meter").setAttribute("aria-valuenow", String(total));
            calc.dataset.state = state;
            $("calc-status").textContent = STATES[state][0];
            $("calc-status-text").textContent = STATES[state][1];
            $("calc-cta").href = waHref(names.length
              ? "Hola Comercial Bedón, quiero cotizar el generador CB9000 (16 HP). Quiero alimentar: " + names.join(", ") + ". Consumo estimado: " + fmt(total) + " W. ¿Me ayudan a confirmar si me alcanza?"
              : "Hola Comercial Bedón, quiero cotizar el generador CB9000 (16 HP). ¿Me ayudan a calcular mi consumo?");
          };
          var setPressed = function (active) {
            presetBtns.forEach(function (p) { p.setAttribute("aria-pressed", p === active ? "true" : "false"); });
          };
          var applyPreset = function (btn) {
            var ids = btn.dataset.preset ? btn.dataset.preset.split(",") : [];
            boxes.forEach(function (b) { b.checked = ids.indexOf(b.value) !== -1; });
            setPressed(ids.length ? btn : null);
            update();
          };
          boxes.forEach(function (b) { b.addEventListener("change", function () { setPressed(null); update(); }); });
          presetBtns.forEach(function (btn) { btn.addEventListener("click", function () { applyPreset(btn); }); });
          // Start with the "Casa" scenario so the result card shows a real example.
          if (!boxes.some(function (b) { return b.checked; })) applyPreset(presetBtns[0]);
          else update();
        }

        // Feature hotspots
        var fx = document.getElementById("features");
        if (fx) {
          var spots = fx.querySelectorAll("[data-spot]");
          var feats = fx.querySelectorAll("[data-feature]");
          var activate = function (n) {
            spots.forEach(function (s) {
              var on = s.dataset.spot === n;
              s.classList.toggle("is-active", on);
              s.setAttribute("aria-pressed", on ? "true" : "false");
            });
            feats.forEach(function (f) { f.classList.toggle("is-active", f.dataset.feature === n); });
          };
          spots.forEach(function (s) {
            s.addEventListener("click", function () { activate(s.dataset.spot); });
            s.addEventListener("mouseenter", function () { activate(s.dataset.spot); });
          });
          feats.forEach(function (f) {
            f.addEventListener("click", function () { activate(f.dataset.feature); });
            f.addEventListener("mouseenter", function () { activate(f.dataset.feature); });
          });
        }

        // Mobile sticky CTA: visible between the hero and the final CTA
        var bar = document.querySelector(".mobile-cta");
        var hero = document.querySelector(".hero");
        var finalCta = document.getElementById("cotizar");
        if (bar && hero && finalCta && "IntersectionObserver" in window) {
          var heroIn = true, finalIn = false;
          var sync = function () {
            var show = !heroIn && !finalIn;
            bar.classList.toggle("is-visible", show);
            bar.setAttribute("aria-hidden", show ? "false" : "true");
            bar.querySelector("a").tabIndex = show ? 0 : -1;
          };
          new IntersectionObserver(function (e) { heroIn = e[0].isIntersecting; sync(); }).observe(hero);
          new IntersectionObserver(function (e) { finalIn = e[0].isIntersecting; sync(); }).observe(finalCta);
        }

        // Analytics hooks (no-op unless GTM, GA4 or Meta Pixel are installed)
        document.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest("[data-cta]");
          if (!a) return;
          var cta = a.getAttribute("data-cta");
          if (window.dataLayer) window.dataLayer.push({ event: "whatsapp_click", cta: cta });
          if (window.gtag) window.gtag("event", "whatsapp_click", { cta: cta });
          if (window.fbq) window.fbq("track", "Contact", { content_name: "Generador CB9000", cta: cta });
        });
      })();
    </script>
  </body>
</html>
